table.insert(cn, RS.Heartbeat:Connect(function(dt)
  if not run then
    return
  end
  rst()
  if not (tm and tm.Parent and rp and rp.Parent and hm and hm.Parent and hm.Health > 0) then
    sv = Vector3.zero
    return
  end
  local cf = rp.CFrame
  local av = rp.AssemblyLinearVelocity
  local xz = pd * mx(sn(g.P_XZMulti, 1.3), 0)
  local y = pd * mx(sn(g.P_YMulti, 1), 0)
  local tv = v3(av.X * xz, av.Y * y, av.Z * xz)
  local la = cl(sn(g.P_Lerp, .05), 0, 1)
  local a = 1 - (1 - la) ^ (mx(sn(dt, 0), 0) * 60)
  sv = sv:Lerp(tv, a)
  local pv = pb(sv)
  if pv.Magnitude > 0 then
    local ok = pcall(function()
      rp.CFrame = cf + pv
    end)
    if ok then
      ld = pv
      im = true
    else
      ld = Vector3.zero
      im = false
    end
  else
    ld = Vector3.zero
    im = false
  end
end))
