g.P_YMulti = tonumber(g.P_YMulti) or 1
g.P_XZMulti = tonumber(g.P_XZMulti) or 1.3
g.P_Lerp = tonumber(g.P_Lerp) or .05
local M = .05
local function GS(n)
  return game:GetService(n)
end
local Pl, RS, St, SG = GS"Players", GS"RunService", GS"Stats", GS"StarterGui"
local W = workspace
local LP = Pl.LocalPlayer
local BC = W.Blockcast
if type(BC) ~= "function" then
  error("Blockcast unavailable")
end
local sv, ld, im = Vector3.zero, Vector3.zero, false
local tm, rp, hm
local cid = 0
local MM, EO, pd = .01, .06, .04
local mx, mn, cl, v3 = math.max, math.min, math.clamp, Vector3.new
local rc = RaycastParams.new()
rc.FilterType = Enum.RaycastFilterType.Exclude
rc.RespectCanCollide = true
rc.IgnoreWater = true
local bf, bs = {}, {}
local bn = 0
local run = true
local cn = {}
local function sn(v, d)
  local n = tonumber(v)
  if not n or n ~= n or n == math.huge or n == - math.huge then
    return d
  end
  return n
end
local function rst()
  if im and rp and rp.Parent then
    pcall(function()
      rp.CFrame = rp.CFrame - ld
    end)
  end
  ld = Vector3.zero
  im = false
end
local function cln()
  rst()
  tm, rp, hm = nil, nil, nil
  sv = Vector3.zero
  table.clear(bf)
  table.clear(bs)
  bn = 0
end
local function cb(m, cf, pl)
  local a = v3(math.huge, math.huge, math.huge)
  local b = v3(- math.huge, - math.huge, - math.huge)
  local f = false
  local iv = cf:Inverse()
  for _, n in ipairs(pl) do
    local p = m:FindFirstChild(n)
    if p and p:IsA("BasePart") then
      f = true
      local r = iv * p.CFrame
      local h = p.Size / 2
      for x = - 1, 1, 2 do
        for y = - 1, 1, 2 do
          for z = - 1, 1, 2 do
            local c = r * v3(h.X * x, h.Y * y, h.Z * z)
            a = v3(mn(a.X, c.X), mn(a.Y, c.Y), mn(a.Z, c.Z))
            b = v3(mx(b.X, c.X), mx(b.Y, c.Y), mx(b.Z, c.Z))
          end
        end
      end
    end
  end
  if f then
    return a, b
  end
end
local function ab(i, a, b, s, yo)
  if not a or not b then
    return
  end
  if s then
    local m = mx(- a.X, b.X)
    a = v3(- m, a.Y, a.Z)
    b = v3(m, b.Y, b.Z)
  end
  if yo then
    a = v3(a.X, mn(a.Y + yo, b.Y - .1), a.Z)
  end
  local d = b - a
  bf[i] = CFrame.new((a + b) / 2)
  bs[i] = v3(mx(d.X - M * 2, .1), mx(d.Y - M * 2, .1), mx(d.Z - M * 2, .1))
end
local function scb(ch, hrp, hum)
  table.clear(bf)
  table.clear(bs)
  bn = 0
  local h, t, l
  if hum.RigType == Enum.HumanoidRigType.R15 then
    h = {
      "Head"
    }
    t = {
      "UpperTorso",
      "LowerTorso",
      "LeftUpperArm",
      "LeftLowerArm",
      "LeftHand",
      "RightUpperArm",
      "RightLowerArm",
      "RightHand"
    }
    l = {
      "LeftUpperLeg",
      "LeftLowerLeg",
      "LeftFoot",
      "RightUpperLeg",
      "RightLowerLeg",
      "RightFoot"
    }
  else
    h = {
      "Head"
    }
    t = {
      "Torso",
      "Left Arm",
      "Right Arm"
    }
    l = {
      "Left Leg",
      "Right Leg"
    }
  end
  local a, b = cb(ch, hrp.CFrame, h)
  ab(1, a, b, false)
  a, b = cb(ch, hrp.CFrame, t)
  ab(2, a, b, true)
  a, b = cb(ch, hrp.CFrame, l)
  ab(3, a, b, true, .5)
  local s = hrp.Size
  local d = {
    {
      CFrame.new(0, s.Y * .75, 0),
      v3(s.X * .45, s.Y * .4, s.Z * .9)
    },
    {
      CFrame.new(),
      v3(s.X * 1.8, s.Y * .8, s.Z * .9)
    },
    {
      CFrame.new(0, - s.Y, 0),
      v3(s.X * .9, s.Y * .8, s.Z * .9)
    }
  }
  for i = 1, 3 do
    if not bf[i] then
      bf[i] = d[i][1]
      bs[i] = d[i][2]
    end
  end
  bn = 3
end
local function ic(ch)
  if not run then
    return
  end
  cid = cid + 1
  local id = cid
  cln()
  local hrp = ch:WaitForChild("HumanoidRootPart", 10)
  local hum = ch:WaitForChild("Humanoid", 10)
  if not run or id ~= cid or not hrp or not hum then
    return
  end
  if not hrp:IsA("BasePart") or not hum:IsA("Humanoid") then
    return
  end
  rc.FilterDescendantsInstances = {
    ch
  }
  pcall(function()
    rc.CollisionGroup = hrp.CollisionGroup
  end)
  scb(ch, hrp, hum)
  if not run or id ~= cid then
    return
  end
  tm, rp, hm = ch, hrp, hum
end
local function nh(cf, d)
  local bd, bnr
  for i = 1, bn do
    local ok, r = pcall(BC, W, cf * bf[i], bs[i], d, rc)
    if ok and r then
      local ds, n = r.Distance, r.Normal
      if type(ds) == "number" and ds == ds and ds >= 0 and n and n:Dot(d) < - 1e-4 then
        if not bd or ds < bd then
          bd, bnr = ds, n
        end
      end
    end
  end
  return bd, bnr
end
local function pb(v)
  if v.Magnitude < MM or bn == 0 or not rp then
    return v
  end
  local bc = rp.CFrame
  local t = Vector3.zero
  local r = v
  for _ = 1, 3 do
    local m = r.Magnitude
    if m < MM then
      break
    end
    local d, n = nh(bc + t, r)
    if not d then
      t += r
      break
    end
    local u = r / m
    local tr = cl(d - EO, 0, m)
    t += u * tr
    local l = u * (m - tr)
    r = l - n * l:Dot(n)
  end
  return t
end
local function ul()
  if not run then
    return
  end
  run = false
  cid = cid + 1
  cln()
  pcall(function()
    RS:UnbindFromRenderStep("FunkFun")
  end)
  for _, c in ipairs(cn) do
    pcall(function()
      c:Disconnect()
    end)
  end
  table.clear(cn)
  if g.FF_CU == ul then
    g.FF_CU = nil
  end
end
