  local ph = table.create(20, 0)
  local hi, sp, cp = 0, 0, 0
  local ps
  while run do
    if not ps then
      local ok, s = pcall(function()
        return St.Network.ServerStatsItem["Data Ping"]
      end)
      if ok then
        ps = s
      end
    end
    if ps then
      local ok, v = pcall(function()
